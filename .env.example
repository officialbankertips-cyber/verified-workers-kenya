NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/verified_workers
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword!

# Optimapay M-Pesa STK Push. Keep API credentials private on the server.
OPTIMAPAY_BASE_URL=https://optimapaybridge.co.ke/api/v2
OPTIMAPAY_API_KEY=
OPTIMAPAY_API_SECRET=
OPTIMAPAY_PAYMENT_ACCOUNT_ID=

# Cloudflare R2 private document storage. Keep the bucket private.
S3_BUCKET=verified-workers-private-documents
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Replace ACCOUNT_ID with your Cloudflare account ID.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# SMTP email delivery (optional until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Verified Workers <no-reply@example.com>
